# ── Google Gemini ────────────────────────────────────────────
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# ── Pinecone Vector Store ────────────────────────────────────
PINECONE_API_KEY=
PINECONE_INDEX_NAME=karan-systems-data
PINECONE_NAMESPACE=
GDRIVE_FOLDER_ID=

# ── RAG Config ───────────────────────────────────────────────
TOP_K=5

# ── App Config ───────────────────────────────────────────────
LOG_LEVEL=INFO

# ── SMTP Email Config (for MCP Scheduler) ────────────────────
MAIL_SENDER=
MAIL_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Optional: set a Google Meet link to enable meeting links
GOOGLE_MEET_LINK=# Karan Systems — Secure Agentic RAG
